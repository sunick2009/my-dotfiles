#!/usr/bin/env bash
set -euo pipefail

echo ""
echo "══════════════════════════════════════════════"
echo "  Stage 1/4 · pre-flight: dependency check"
echo "══════════════════════════════════════════════"
echo ""

MISSING=()
for cmd in zsh git curl tmux nvim jq; do
    if command -v "$cmd" >/dev/null 2>&1; then
        echo "  [OK]  $cmd ($(command -v "$cmd"))"
    else
        echo "  [!!]  $cmd — NOT FOUND"
        MISSING+=("$cmd")
    fi
done

if [ ${#MISSING[@]} -eq 0 ]; then
    echo ""
    echo "  All dependencies present."
    exit 0
fi

echo ""
echo "  Missing: ${MISSING[*]}"
echo ""

{{ if eq .chezmoi.os "darwin" -}}
echo "  Recommended install command:"
echo ""
echo "    brew install ${MISSING[*]}"
{{- else if eq .chezmoi.os "linux" -}}
if command -v apt-get >/dev/null 2>&1; then
    PKGS=()
    for cmd in "${MISSING[@]}"; do
        case "$cmd" in nvim) PKGS+=("neovim") ;; *) PKGS+=("$cmd") ;; esac
    done
    echo "  Recommended install command:"
    echo ""
    echo "    sudo apt-get update && sudo apt-get install -y ${PKGS[*]}"
elif command -v dnf >/dev/null 2>&1; then
    PKGS=()
    for cmd in "${MISSING[@]}"; do
        case "$cmd" in nvim) PKGS+=("neovim") ;; *) PKGS+=("$cmd") ;; esac
    done
    echo "  Recommended install command:"
    echo ""
    echo "    sudo dnf install -y ${PKGS[*]}"
elif command -v pacman >/dev/null 2>&1; then
    PKGS=()
    for cmd in "${MISSING[@]}"; do
        case "$cmd" in nvim) PKGS+=("neovim") ;; *) PKGS+=("$cmd") ;; esac
    done
    echo "  Recommended install command:"
    echo ""
    echo "    sudo pacman -S ${PKGS[*]}"
else
    echo "  Install the following with your system package manager: ${MISSING[*]}"
fi
{{- end }}
echo ""
echo "  After installing, re-run: chezmoi apply"
exit 1
