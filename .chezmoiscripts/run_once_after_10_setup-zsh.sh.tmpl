#!/usr/bin/env bash
set -euo pipefail

echo ""
echo "══════════════════════════════════════════════"
echo "  Stage 2/4 · post-apply: shell setup"
echo "══════════════════════════════════════════════"
echo ""

{{- if .changeShell }}
ZSH_PATH="$(command -v zsh 2>/dev/null || true)"
if [ -z "$ZSH_PATH" ]; then
    echo "  [!!]  zsh not found — skipping shell change."
    exit 0
fi

CURRENT_SHELL="$(getent passwd "$USER" 2>/dev/null | cut -d: -f7 \
    || dscl . -read "/Users/$USER" UserShell 2>/dev/null | awk '{print $2}' \
    || true)"

if [ "$CURRENT_SHELL" = "$ZSH_PATH" ]; then
    echo "  [OK]  Default shell is already zsh ($ZSH_PATH)."
    exit 0
fi

echo "  [--]  Changing default shell to $ZSH_PATH ..."

# sudo chsh avoids PAM user-password prompt (works on passwordless accounts)
if sudo chsh -s "$ZSH_PATH" "$USER" 2>/dev/null; then
    echo "  [OK]  Shell changed via sudo chsh. Restart terminal to take effect."
elif sudo usermod -s "$ZSH_PATH" "$USER" 2>/dev/null; then
    echo "  [OK]  Shell changed via sudo usermod. Restart terminal to take effect."
else
    echo "  [!!]  Could not change shell automatically (no sudo or no password)."
    echo "        Run manually:"
    echo "          sudo chsh -s $ZSH_PATH $USER"
    echo "        or:"
    echo "          sudo usermod -s $ZSH_PATH $USER"
fi
{{- else }}
echo "  [--]  Skipping shell change (changeShell=false)."
echo "        To change manually: sudo chsh -s \$(which zsh) \$USER"
{{- end }}
