#!/usr/bin/env bash
set -euo pipefail

echo ""
echo "══════════════════════════════════════════════"
echo "  Stage 3/4 · post-apply: font install"
echo "══════════════════════════════════════════════"
echo ""

{{- if .installFonts }}
REPO_DIR="{{ .chezmoi.sourceDir }}"
FONTS_SRC="$REPO_DIR/fonts/mac_linux"

if [ ! -d "$FONTS_SRC" ]; then
    echo "  [!!]  fonts/mac_linux not found in source repo — skipping."
    exit 0
fi

{{ if eq .chezmoi.os "darwin" -}}
FONT_DEST="$HOME/Library/Fonts/HackFonts"
mkdir -p "$FONT_DEST"
cp -fv "$FONTS_SRC/"*.ttf "$FONT_DEST/"
echo "  [OK]  Hack fonts installed to $FONT_DEST"

{{- else if eq .chezmoi.os "linux" -}}
FONT_DEST="$HOME/.local/share/fonts/HackFonts"
mkdir -p "$FONT_DEST"
cp -fv "$FONTS_SRC/"*.ttf "$FONT_DEST/"
if command -v fc-cache >/dev/null 2>&1; then
    fc-cache -fv "$FONT_DEST"
fi
echo "  [OK]  Hack fonts installed to $FONT_DEST"
{{- end }}
{{- else }}
echo "  [--]  Skipping font install (installFonts=false)."
{{- end }}
