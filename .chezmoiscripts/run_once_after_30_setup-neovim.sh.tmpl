#!/usr/bin/env bash
set -euo pipefail

echo ""
echo "══════════════════════════════════════════════"
echo "  Stage 4/4 · post-apply: neovim setup"
echo "══════════════════════════════════════════════"
echo ""

{{ if .installNeovimPlugins -}}
PLUG_PATH="$HOME/.local/share/nvim/site/autoload/plug.vim"

if ! command -v nvim >/dev/null 2>&1; then
    echo "  [!!]  nvim not found — skipping plugin install."
    echo "        Install neovim and re-run: chezmoi apply"
    exit 0
fi

if [ ! -f "$PLUG_PATH" ]; then
    echo "  [--]  Installing vim-plug..."
    mkdir -p "$(dirname "$PLUG_PATH")"
    curl -fLo "$PLUG_PATH" \
        https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim
    echo "  [OK]  vim-plug installed."
else
    echo "  [OK]  vim-plug already present."
fi

echo "  [--]  Running :PlugInstall (headless)..."
nvim --headless +PlugInstall +qall 2>&1
echo "  [OK]  Neovim plugins installed."
{{- else }}
echo "  [--]  Skipping neovim plugin install (installNeovimPlugins=false)."
{{- end }}
